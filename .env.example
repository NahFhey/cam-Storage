# CAM Tracking Kiosk - environment variables
#
# The app reads these from the process environment; it does not load .env
# files. On a kiosk, set them as Environment= lines in cam-tracking.service.
# For a local run: set -a; . ./.env; set +a; venv/bin/python main.py
#
# Sign-in is by PIN. A new database has one admin user with PIN 1234;
# change it under Admin -> Users.
#
# Auto-bump and default material life are not environment variables: they
# are stored in the database and changed under Admin -> Settings & data.

# SQLite database file (created on first start)
CAM_DB_PATH=./cam_tracking.db

# Server address and port. 0.0.0.0 = reachable from the network;
# 127.0.0.1 = this machine only.
HOST=0.0.0.0
PORT=8000

# Hours a sign-in stays valid (the UI also signs out after 5 idle minutes)
SESSION_DURATION_HOURS=8

# Operator recorded for system-created moves (tool creation)
DEFAULT_OPERATOR=kiosk
